<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch / splash theme: black, no action bar, transparent
         system bars so the splash is just a black rectangle.
         Applied via android:theme on the launcher activity in the
         manifest, then NormalTheme takes over once Flutter boots. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Post-launch theme: black background, dark status bar, no
         action bar (Flutter draws its own AppBar). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>